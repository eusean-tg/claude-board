.vault.json


# Tauri build artifacts: tauri-build regenerates these on every Rust build,
# so tracking them means a dirty tree after each build and constant merge noise.
# They only feed editor validation of capabilities/*.json; nothing reads them at
# runtime and the build recreates whatever is missing.
src-tauri/gen/schemas/

# pnpm is the package manager; a stray package-lock.json means npm was used
# by mistake and the two lockfiles will drift.
package-lock.json

# Generated by scripts/bundle-mcp.mjs — the shipped, dependency-inlined sidecar.
src-tauri/resources/mcp-server.bundle.js
