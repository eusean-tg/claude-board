{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Claude Board",
  "description": "AI orchestration platform — run multiple Claude agents with dependency graphs, wave execution, and live observability.",
  "colors": {
    "primary": "#DA7756",
    "light": "#E8926E",
    "dark": "#C45A3C"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://github.com/bahri-hirfanoglu/claude-board"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark"
  },
  "navbar": {
