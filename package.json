{
  "name": "claude-board",
  "version": "1.12.0",
  "packageManager": "pnpm@10.34.4",
  "private": true,
  "description": "Visual task management board for Claude Code \u2014 manage AI-powered development tasks with a Kanban-style interface",
  "author": {
    "name": "Bahri Hirfanoglu",
    "email": "bahri@hirfanoglu.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "client": "cd client && pnpm dev",
    "build": "cd client && pnpm build",
    "setup": "pnpm install && cd client && pnpm install",
    "tauri": "tauri",
    "tauri:dev": "pnpm exec tauri dev",
    "tauri:build": "pnpm exec tauri build",
    "lint": "cd client && pnpm exec eslint src/",
    "lint:fix": "cd client && pnpm exec eslint src/ --fix",
    "test": "cd client && pnpm exec vitest run",
    "format": "prettier --write \"client/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx}\"",
    "prepare": "husky",
    "mcp:bundle": "node scripts/bundle-mcp.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "esbuild": "^0.25.0"
  },
  "lint-staged": {
    "client/src/**/*.{js,jsx}": [
      "eslint --max-warnings 10"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
